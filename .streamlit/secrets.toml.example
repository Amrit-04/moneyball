# Streamlit Secrets Template
# Copy this file to secrets.toml and fill in your API keys
# DO NOT commit secrets.toml to version control!

# Gemini API (for CIO agent)
GEMINI_API_KEY = "your-gemini-api-key-here"

# CoinGecko API (for crypto data)
COINGECKO_API_KEY = "your-coingecko-api-key-here"

# Dune Analytics API (for on-chain data)
DUNE_API_KEY = "your-dune-api-key-here"

# Reddit API (for sentiment)
REDDIT_CLIENT_ID = "your-reddit-client-id"
REDDIT_CLIENT_SECRET = "your-reddit-client-secret"
REDDIT_USER_AGENT = "MoneyballBot/1.0"

# GitHub API (for developer activity)
GITHUB_TOKEN = "your-github-token-here"

# Alpha Vantage (optional, for additional stock data)
ALPHA_VANTAGE_API_KEY = "your-alpha-vantage-key-here"
