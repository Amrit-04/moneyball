# Moneyball .gitignore

# Data directories (large files, not for version control)
/data/
!/data/.gitkeep
!/data/raw/.gitkeep
!/data/features/.gitkeep

# Logs
logs/
*.log
!logs/.gitkeep

# Models (large binary files - trained model outputs only)
/models/
!models/.gitkeep
*.pkl
*.joblib
*.h5
*.pt
*.pth

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebooks
.ipynb_checkpoints
*.ipynb

# Streamlit
.streamlit/secrets.toml

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Temporary files
*.tmp
*.bak
*.cache

# OS
Thumbs.db
.DS_Store
